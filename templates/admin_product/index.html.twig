{% extends 'base.html.twig' %}

{% block title %}Liste des Produits{% endblock %}

{% block body %}
    {% embed 'partials/_list.html.twig' with {
        titre: 'des produits',
        route_add: 'app_admin_product_add',
        nom_col: nom_col,
        datas: products,
        val_filter:  val_filter
    } %}
        {% block tableauDonnee %}

                    {% for product in products %}
                        <tr>
                            <td><img src="{{ product.picture}}" alt="imagge_product_{{ product.name }}" width="100px" height="100px" ></td>
                            <td>{{ product.category.name }}</td>
                            <td>{{ product.name }}</td>
                            <td>{{ product.slug }}</td>
                            <td>{{ product.description |slice(0, 50)}}...</td>
                            <td>{{ product.price | round(2, 'common')}}€</td>
                            <td>{{ product.stock }}</td>
                            <td>
                                <a href="{{path('app_admin_product_remove', parameters = {id:product.id})}}" class="btn btn-danger mb-3"> <i class="bi bi-trash text-dark"></i> </a>
                                <a href="{{path('app_admin_product_update', parameters = {id:product.id})}}" class="btn btn-primary mb-3"> <i class="bi bi-pencil text-dark"></i> </a>
                            </td>
                        </tr>
                    {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
