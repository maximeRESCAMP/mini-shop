{% extends 'base.html.twig' %}

{% block title %}Liste des produits{% endblock %}

{% block body %}
    {% embed 'partials/_list.html.twig' with {
        titre: 'des produits',
        route_add: 'app_admin_product_add',
        route_add_name: 'un produit',
        nom_col: nom_col
    } %}
        {% block tableauDonnee %}
                    {% for product in products %}
                        <tr>

                            <td><img src="{{ product.picture}}" alt="imagge_product_{{ product.name }}" width="100px" height="100px" ></td>

                            <td>{{ product.category.name }}</td>
                            <td>
                                <a href="{{ path('app_product_detail', {id: product.id}) }}"
                                   class="text-decoration-none fw-bold">
                                    {{ product.name }}
                                </a>
                            </td>
                            <td>{{ product.price | round(2, 'common') }}€</td>
                            <td>
                                {% if product.stock < 1 %}
                                    <button class="btn btn-secondary" disabled>Plus de stock</button>
                                {% endif %}
                                {% if (product.id in itemsCartOrder) %}
                                    <a href="{{ path('app_cart_item_delete_by_product',{id: product.id}) }}"
                                       class="btn btn-danger mb-3">Supprimer du panniers</a>
                                {% else %}
                                    {% if product.stock > 0 %}
                                        <a href="{{ path('app_cart_item_add',{id: product.id}) }}"
                                           class="btn btn-primary mb-3">Ajouter au pannier</a>
                                    {% endif %}

                                {% endif %}


                            </td>
                        </tr>
                    {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

{% endblock %}
