{% extends 'base.html.twig' %}

{#{% block title %}Detail de la commande {{ order.reference }}{% endblock %}#}

{% block body %}
    <div class="container py-5">
        <div class="bg-white shadow rounded p-4">
{#            <h1 class="text-center mb-4">Detail de la commande {{ order.reference }}</h1>#}
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle text-center">
                    <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>{{ knp_pagination_sortable(ordersItems,'Nom','p.name') }}</th>
                        <th>{{ knp_pagination_sortable(ordersItems,'Quantité','oi.quantity') }}</th>
                        <th>{{ knp_pagination_sortable(ordersItems,'Prix Unitaire','oi.unitPrice') }}</th>
                        <th>{{ knp_pagination_sortable(ordersItems,'Total','oi.total') }}</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for orderItem in ordersItems %}
                        <tr>
                            <td>
                                <img src="{{ orderItem.product.picture }}" alt="imagge_product_{{ orderItem.product.name }}" width="100px" height="100px">
                            </td>

                            <td>{{ orderItem.product.name }}</td>
                            <td>{{ orderItem.quantity }}</td>
                            <td>{{ orderItem.unitPrice | round(2,'common') }}</td>
                            <td>{{ orderItem.total | round(2,'common') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {{ knp_pagination_render(ordersItems) }}

            </div>
        </div>
    </div>
{% endblock %}
