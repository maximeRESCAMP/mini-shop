{% extends 'base.html.twig' %}

{% block title %}Detail de la commande {{ order.reference }}{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="bg-white shadow rounded p-4">
            <h1 class="text-center mb-4">Detail de la commande {{ order.reference }}</h1>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle text-center">
                    <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Nom</th>
                        <th>Quantité</th>
                        <th>Prix Unitaire</th>
                        <th>Total</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for orderItem in order.orderItems %}
                        <tr>
                            <td>{{ orderItem.product.picture }}</td>
                            <td>{{  orderItem.product.name }}</td>
                            <td>{{  orderItem.quantity }}</td>
                            <td>{{ orderItem.unitPrice | round(2,'common') }}</td>
                            <td>{{ orderItem.total | round(2,'common') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
