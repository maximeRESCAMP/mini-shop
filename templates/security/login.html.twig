{% extends 'base.html.twig' %}

{% block title %}{{ 'user.login.title' |trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center align-items-center h-100">
        <form method="post" class="p-4 shadow rounded bg-white w-25">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <h1 class="h3 mb-3 font-weight-normal text-center">{{ 'user.list.connect' | trans }}</h1>
            <label for="username">{{ 'user.list.form.email' |trans }}</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control"
                   autocomplete="email" required autofocus>
            <label for="password" class="mt-2">{{ 'user.list.form.password' |trans }}</label>
            <input type="password" name="_password" id="password" class="form-control"
                   autocomplete="current-password"
                   required>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                   value="{{ csrf_token('authenticate') }}">
            <button class="btn btn-primary w-100 mt-4" type="submit">
                {{ 'user.list.form.login' | trans }}
            </button>
        </form>
    </div>
{% endblock %}
