{% extends 'base.html.twig' %}

{% block title %}{{ 'user.list.title'| trans }}{% endblock %}

{% block body %}
    {% embed 'partials/_form.html.twig' with {
        title: 'user.list.title',
        is_update: false,
    } %}
        {% block form %}
            {{ form_start(form) }}
            <div class="my-custom-class-for-errors mb-3">
                {{ form_errors(form) }}
            </div>

            <fieldset class="border rounded p-4 mb-4">
                <legend class="w-auto px-2 fw-bold">{{ 'user.list.personal' | trans }}</legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.phone) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.password.first) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.password.second) }}
                    </div>


                    <div class="col-md-6">
                        {{ form_row(form.firstName) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.lastName) }}
                    </div>
                </div>
            </fieldset>
            <fieldset class="border rounded p-4 mb-4">
                <legend class="w-auto px-2 fw-bold">{{ 'user.list.delivery_address' | trans }}</legend>

                {% for deliveryAddresses in form.addresses %}
                    {{ form_row(deliveryAddresses) }}
                {% endfor %}

            </fieldset>

            <div>
                {{ form_row(form.save) }}
            </div>
            {{ form_end(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
