{% extends 'base.html.twig' %}

{% block title %}{{ 'cart_item.list.title'| trans }}{% endblock %}


{% block body %}
    {% embed 'partials/_list.html.twig' with {
        titre: 'cart_item.list.title',
        route_add: false,
        nom_col: nom_col,
        'datas':cartItems
    } %}
        {% block tableauDonnee %}

            {% for cartItem in cartItems %}
                <tr>
                    <td><img src="{{ asset('pictures/' ~ cartItem.product.getSlug()~'.jpg') }}" alt={{ cartItem.product.name }} width="100px"
                             height="100px">
                    </td>
                    <td>{{ cartItem.product.name }}</td>
                    <td>{{ cartItem.product.price | round(2,'common') }}</td>
                    <td>{{ cartItem.quantity }}</td>
                    <td>
                        <a href="{{ path('app_cart_item_delete_cart', parameters = {id:cartItem.id}) }}"
                           class="btn btn-danger mb-3">  <i class="bi bi-trash text-dark"></i></a>
                    </td>
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
