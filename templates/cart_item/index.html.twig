{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    {% embed 'partials/_list.html.twig' with {
        titre: 'des articles de votre panier',
        route_add: false,
        nom_col: nom_col
    } %}
        {% block tableauDonnee %}

            {% for cartItem in cartItems %}
                <tr>
                    <td><img src="{{ cartItem.product.picture }}" alt={{ cartItem.product.name }} width="100px"
                             height="100px">
                    </td>
                    <td>{{ cartItem.product.name }}</td>
                    <td>{{ cartItem.product.price | round(2,'common') }}</td>
                    <td>{{ cartItem.quantity }}</td>
                    <td>
                        <a href="{{ path('app_cart_item_delete_cart', parameters = {id:cartItem.id}) }}"
                           class="btn btn-danger mb-3"> Supprimer</a>
                    </td>
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
