<div class="container py-5">
    <div class="bg-white shadow rounded p-4">
        <h1 class="text-center mb-4">Liste {{ titre }}</h1>
        {% if route_add %}
            <div class="d-flex justify-content-end">
                <a href="{{ path(route_add) }}" class="btn btn-success mb-3">
                    <i class="bi bi-plus-circle-fill text-dark"></i>
                    Ajouter
                </a>
            </div>
        {% endif %}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle text-center">
                <thead class="table-dark">
                <tr>
                    {% for key, col in nom_col %}
                        {% if col in ['Action','Image'] %}
                            <th> {{ col }}</th>
                        {% else %}
                            <th>{{ knp_pagination_sortable(datas,col,val_filter[key]) }}</th>
                        {% endif %}
                    {% endfor %}
                </tr>
                </thead>
                <tbody>

                {% block tableauDonnee %}{% endblock %}
                </tbody>

            </table>
            {{ knp_pagination_render(datas) }}

        </div>
    </div>
</div>
