{% extends 'base.html.twig' %}
{% if is_update %}
    {% set createOrUpdate = 'Modifier' %}
{% else %}
    {% set createOrUpdate = 'Créer' %}
{% endif %}
{% block title %} {{ createOrUpdate }} une adresse de livraison{% endblock %}

{% block body %}
    {% embed 'partials/_form.html.twig' with {
        name: 'une adresse de livraison',
        createUpdate: createOrUpdate,
    } %}

        {% block form %}
            {{ form_start(form) }}
            <div class="my-custom-class-for-errors mb-3">
                {{ form_errors(form) }}
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.country) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.zipCode) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.city) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.street) }}
                </div>
                <div>
                    <button class="btn btn-primary w-100"> {{ createOrUpdate }}</button>
                </div>
            </div>
            {{ form_end(form) }}

        {% endblock %}
    {% endembed %}

{% endblock %}
