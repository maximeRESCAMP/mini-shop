{% extends 'base.html.twig' %}

{% block title %}Liste de mes adresses de Livraison{% endblock %}

{% block body %}
    {% embed 'partials/_list.html.twig' with {
        titre: 'des adresses de Livraison',
        route_add: 'app_address_add',
        route_add_name: 'une adresse de livraison',
        nom_col: nom_col
    } %}
        {% block tableauDonnee %}
            {% for deliveryAddres in addresses %}
                <tr>
                    <td>{{ deliveryAddres.country }}</td>
                    <td>{{ deliveryAddres.zipCode }}</td>
                    <td>{{ deliveryAddres.city }}</td>
                    <td>{{ deliveryAddres.street }}</td>
                    <td>
                        <a href="{{ path('app_address_delete', parameters = {id:deliveryAddres.id}) }}"
                           class="btn btn-danger mb-3"> Supprimer</a>
                        <a href="{{ path('app_address_update', parameters = {id:deliveryAddres.id}) }}"
                           class="btn btn-primary mb-3"> Modifier</a>
                    </td>
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
