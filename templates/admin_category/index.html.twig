{% extends 'base.html.twig' %}

{% block title %}Liste des Catégories{% endblock %}

{% block body %}
    {% embed 'partials/_list.html.twig' with {
        titre: 'des catégories',
        route_add: 'app_admin_category_add',
        route_add_name: 'une catégorie',
        nom_col: nom_col
    } %}
        {% block tableauDonnee %}

            {% for category in categories %}
                <tr>
                    <td>{{ category.name }}</td>
                    <td>{{ category.slug }}</td>
                    <td>
                        <a href="{{ path('app_admin_category_remove', parameters = {id:category.id}) }}"
                           class="btn btn-danger mb-3"> Supprimer une catégorie </a>
                        <a href="{{ path('app_admin_category_update', parameters = {id:category.id}) }}"
                           class="btn btn-primary mb-3"> Modifier une catégorie </a>
                    </td>
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
