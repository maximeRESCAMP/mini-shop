{% extends 'base.html.twig' %}

{% block title %}{{ 'category.list.title' | trans}}{% endblock %}

{% block body %}
    {% embed 'partials/_list.html.twig' with {
        titre: 'category.list.title',
        route_add: 'app_admin_category_add',
        nom_col: nom_col,
        'datas':categories

    } %}
        {% block tableauDonnee %}

            {% for category in categories %}
                <tr>
                    <td>{{ category.name }}</td>
                    <td>{{ category.slug }}</td>
                    <td>
                        <a href="{{ path('app_admin_category_remove', parameters = {id:category.id}) }}"
                           class="btn btn-danger mb-3">  <i class="bi bi-trash text-dark"></i></a>
                        <a href="{{ path('app_admin_category_update', parameters = {slug:category.slug}) }}"
                           class="btn btn-primary mb-3">   <i class="bi bi-pencil text-dark"></i></a>
                    </td>
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
