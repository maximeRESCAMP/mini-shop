{% extends 'base.html.twig' %}
{% if is_update %}
    {% set createOrUpdate = 'form.update' %}
    {% set title ='category.form.title.update' %}
{% else %}
    {% set createOrUpdate = 'form.create' %}
    {% set title ='category.form.title.create' %}

{% endif %}
{% block title %}{{ title |trans }}{% endblock %}

{% block body %}
    {% embed 'partials/_form.html.twig' with {
        title: title,
        createUpdate: createOrUpdate,
    } %}
        {% block form %}
            {{ form_start(form) }}
            <div class="my-custom-class-for-errors mb-3">
                {{ form_errors(form) }}
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.slug) }}
                </div>
            </div>
            <div>
                <button class="btn btn-primary w-100"> {{ createOrUpdate | trans }}</button>
            </div>
            {{ form_end(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
